# Copiare in config/ctrader.env (ignorato da git) e compilare. Mai committare valori reali.
# App registrata su https://openapi.ctrader.com (approvazione manuale di Spotware).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
# demo | live — una connessione per ambiente (demo.ctraderapi.com / live.ctraderapi.com, porta 5035)
CTRADER_ENV=demo
# ctidTraderAccountId del conto Pepperstone EU (da ProtoOAGetAccountListByAccessTokenReq)
CTRADER_ACCOUNT_ID=
# File dei token OAuth, scritto in modo atomico con permessi 600.
# Il refresh invalida la coppia precedente: un solo processo deve rinnovarla.
CTRADER_TOKEN_FILE=secrets/ctrader_tokens.json
